# Follows the macOS system appearance automatically:
# Light mode -> Catppuccin Latte, Dark mode -> Catppuccin Mocha
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
# theme = GruvboxDark
# font-family = Meslo LGS Nerd Font Mono
# font-family = CaskaydiaMono Nerd Font
# font-family = CaskaydiaCove Nerd Font
font-size = 14
# background-opacity = 0.95
gtk-titlebar = false
# custom-shader = /home/chris/bloom.glsl
#custom-shader = /home/chris/crt.glsl

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll
